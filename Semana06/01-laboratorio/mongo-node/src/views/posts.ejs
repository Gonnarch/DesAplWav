<%- include('partials/head', { title: 'Publicaciones' }) %>
<div class="page-heading"><div><h1>Publicaciones</h1><p class="lead">Ideas de nuestra comunidad · <%= posts.length %> publicaciones</p></div></div>
<% if (!posts.length) { %><section class="empty"><h5>Aún no hay publicaciones</h5><p>Ejecuta npm run seed para cargar los datos del laboratorio.</p></section><% } %>
<div class="post-grid"><% posts.forEach(post => { %>
<article class="card post-card">
<div class="post-cover"><span>SOCIAL / IDEAS</span><strong>Mi primera<br>publicación.</strong></div>
<div class="card-content"><h2 class="card-title"><%= post.title %></h2><p class="post-content"><%= post.content %></p>

</div><div class="card-action"><p class="author"><%= post.user ? post.user.name + ' ' + post.user.lastName : 'Autor no disponible' %></p>

</div></article><% }) %></div><%- include('partials/footer') %>
